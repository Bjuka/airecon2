# airecon2 configuration - copy to .env and fill in AT LEAST ONE.
# Any single provider is enough. All are OpenAI-compatible; airecon2 speaks
# the same protocol to every one of them.

# --- hosted providers (pick one or more) ---
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/apikey
OPENAI_API_KEY=          # paid: https://platform.openai.com/api-keys
OPENROUTER_API_KEY=      # free models available: https://openrouter.ai/keys
GROQ_API_KEY=            # free tier: https://console.groq.com/keys
MISTRAL_API_KEY=         # https://console.mistral.ai
DEEPSEEK_API_KEY=        # https://platform.deepseek.com
TOGETHER_API_KEY=        # https://api.together.xyz
XAI_API_KEY=             # https://console.x.ai

# --- local models (no key needed, server must be running) ---
# Ollama:  ollama serve        (default endpoint below)
# LM Studio: start the server  (default endpoint http://127.0.0.1:1234/v1)
# LOCAL_LLM_API_KEY=      # only if your local gateway requires one

# --- any other OpenAI-compatible endpoint (vLLM, LiteLLM, corporate gateway...) ---
# CUSTOM_LLM_BASE_URL=http://127.0.0.1:8000/v1
# CUSTOM_LLM_API_KEY=

# --- permissions ---
# Targets airecon2 is allowed to attack (pentest mode). Comma-separated. * = all.
AUTHORIZED_TARGETS=localhost,127.0.0.1
# 1 = allow the `shell` tool to run commands on this machine (off by default)
SHELL_ENABLED=
